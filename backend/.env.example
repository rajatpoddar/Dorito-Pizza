# Copy to .env and adjust. Used by docker-compose and local dev.
FLASK_CONFIG=docker
SECRET_KEY=super-secret-flask-key-change-me
JWT_SECRET_KEY=super-secret-jwt-key-change-me

# Postgres (compose service name = host)
POSTGRES_USER=dorito
POSTGRES_PASSWORD=dorito
POSTGRES_DB=dorito
DATABASE_URL=postgresql+psycopg2://dorito:dorito@db:5432/dorito

# ---- Observability (P4.5 + P4.6) ----
# Leave SENTRY_DSN empty to disable Sentry entirely (default in dev).
# Get a DSN by creating a project at https://sentry.io and copying the
# DSN from Project Settings → Client Keys (DSN).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set this in your deploy pipeline (`git rev-parse --short HEAD`) so
# Sentry release tracking works. Falls back to "unknown" in dev.
GIT_COMMIT_SHA=
